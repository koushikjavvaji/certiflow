// CertiFlow schema (Phase 1).
//
// Conventions used by EVERY table, so adding a new table or field later is routine:
//   id          uuid primary key (not guessable, safe to expose in URLs)
//   createdAt   set automatically
//   updatedAt   maintained automatically by Prisma
//   isActive    SOFT DELETE: true = active, false = deleted. Rows are never physically
//               removed; the Prisma client in src/db.ts hides inactive rows and turns
//               delete() into "set isActive = false".
//   createdById / updatedById   who made / last changed the row (soft references to
//               User.id: plain columns, not foreign keys, so seed data and system jobs
//               can write rows with no user, and history survives a user's removal)
//   meta        free-form JSON for extra attributes. A new attribute that needs no
//               querying can be stored here with NO migration and NO redeploy.
//
// Append-only tables added later (AuditLog, Approval) deliberately do NOT get
// updatedAt/isActive: a decision record must never be edited or hidden.
//
// Hand-written SQL (partial unique indexes, CHECK constraints) lives in the migration
// file, because Prisma cannot express it here. Search "Hand-written" in migrations/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CENTRE
  DISTRICT_OFFICER
  QUALITY
  STATE
}

// Whether a workflow step is limited to officers of the batch's own district.
enum StepScope {
  DISTRICT // only users whose districtId matches the batch's centre district
  ANY // any user holding the step's role (quality team, state office)
}

// A region. Officers only act on batches from centres in their own district.
// (name is unique among ACTIVE rows: partial index in the migration)
model District {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  meta        Json     @default("{}")

  centres Centre[]
  users   User[]
}

// A training centre. Belongs to exactly one district.
model Centre {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  districtId  String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  meta        Json     @default("{}")

  district District @relation(fields: [districtId], references: [id])
  users    User[]
  batches  Batch[]

  @@index([districtId])
}

// The demo people. No passwords: reviewers switch between them (see /auth/demo-login).
//
// Shape rules, enforced by a CHECK constraint in the migration:
//   CENTRE            -> centreId set,   districtId null
//   DISTRICT_OFFICER  -> districtId set, centreId null
//   QUALITY, STATE    -> both null (they work across all districts)
model User {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  role        Role
  districtId  String?  @db.Uuid
  centreId    String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  meta        Json     @default("{}")

  district District? @relation(fields: [districtId], references: [id])
  centre   Centre?   @relation(fields: [centreId], references: [id])

  @@index([districtId])
  @@index([centreId])
}

// Tunable knobs as DATA, e.g. "workflow.activeVersion", "resubmit.resetApprovals".
// Editing a row in the database changes behaviour within seconds: no code change,
// no redeploy (readers cache for a short time, see src/config-store.ts).
// key is unique among ACTIVE rows (partial index in the migration).
model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  meta        Json     @default("{}")
}

// The approval path as DATA. One row = one review step. Changing "how many district
// officers must agree", the SLA, the order, or the role of a step is a database edit.
//
//   workflowVersion   rules are versioned; a batch will remember the version it started
//                     under (Phase 2), so editing rules never strands a batch mid-flight.
//                     Setting "workflow.activeVersion" says which version new batches use.
//   position          order within the version (1, 2, 3 ...)
//   key               stable machine name, e.g. DISTRICT_REVIEW
//   role / scope      who may act at this step, and whether they must share the district
//   requiredApprovals how many DIFFERENT people must approve before the batch moves on
//   slaMinutes        how long a batch may wait here before escalation (null = no limit)
//   condition         when the step applies. null = always. {"minCandidates": 50} =
//                     only batches with at least 50 candidates (the "big batch" rule)
model WorkflowStep {
  id                String    @id @default(uuid()) @db.Uuid
  workflowVersion   Int       @default(1)
  position          Int
  key               String
  name              String
  role              Role
  scope             StepScope @default(ANY)
  requiredApprovals Int       @default(1)
  slaMinutes        Int?
  condition         Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  isActive          Boolean   @default(true)
  createdById       String?   @db.Uuid
  updatedById       String?   @db.Uuid
  meta              Json      @default("{}")

  @@index([workflowVersion, position])
}

// ============================================================================
// The certificate flow (Phase 2+)
// ============================================================================

enum BatchStatus {
  DRAFT // centre is still adding candidates
  IN_REVIEW // waiting at currentStepKey
  CHANGES_REQUESTED // sent back; centre must fix and resubmit
  REJECTED // closed for good
  APPROVED // all steps passed; issuance not started yet
  ISSUING // certificates are being generated and sent
  COMPLETED // every certificate is SENT or has FAILED (see deliveryStatus)
}

enum CertificateStatus {
  VALID
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED // gave up after all retries; the state office can retry
}

// A group of candidates a training centre sends for certification.
//   version          bumps when a sent-back batch is resubmitted (if approvals reset);
//                    approvals are stored per version, so old ones never count again
//   workflowVersion  which WorkflowStep version this batch started under
//   currentStepKey   where it is waiting (a WorkflowStep.key); null when not in review
//   stepEnteredAt    when it arrived at that step: the SLA clock starts here
//   overdueAt        set once when it breaches the step's SLA (escalation fired)
model Batch {
  id              String      @id @default(uuid()) @db.Uuid
  centreId        String      @db.Uuid
  courseName      String
  status          BatchStatus @default(DRAFT)
  workflowVersion Int         @default(1)
  version         Int         @default(1)
  currentStepKey  String?
  stepEnteredAt   DateTime?
  overdueAt       DateTime?
  lastReason      String?
  candidateCount  Int         @default(0)
  submittedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  isActive        Boolean     @default(true)
  createdById     String?     @db.Uuid
  updatedById     String?     @db.Uuid
  meta            Json        @default("{}")

  centre       Centre        @relation(fields: [centreId], references: [id])
  candidates   Candidate[]
  approvals    Approval[]
  certificates Certificate[]

  @@index([centreId])
  @@index([status])
}

// One person to certify. A person can appear once per course among ACTIVE rows
// (partial unique index on courseCode + phone in the migration), which blocks the same
// candidate being certified twice for the same course through different batches.
model Candidate {
  id          String   @id @default(uuid()) @db.Uuid
  batchId     String   @db.Uuid
  name        String
  phone       String // normalised, e.g. +919876543210
  courseCode  String
  marks       Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
  createdById String?  @db.Uuid
  updatedById String?  @db.Uuid
  meta        Json     @default("{}")

  batch       Batch        @relation(fields: [batchId], references: [id])
  certificate Certificate?

  @@index([batchId])
}

// One officer's approval at one step of one batch version. The unique key means an
// officer cannot approve the same step twice. Withdrawing sets isActive = false; the
// full history of who did what lives in AuditLog.
model Approval {
  id           String   @id @default(uuid()) @db.Uuid
  batchId      String   @db.Uuid
  batchVersion Int
  stepKey      String
  officerId    String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isActive     Boolean  @default(true)
  createdById  String?  @db.Uuid
  updatedById  String?  @db.Uuid
  meta         Json     @default("{}")

  batch Batch @relation(fields: [batchId], references: [id])

  @@unique([batchId, batchVersion, stepKey, officerId])
  @@index([batchId])
}

// Append-only record of every decision and system action. No updatedAt / isActive on
// purpose, and the database refuses UPDATE, DELETE and TRUNCATE (trigger in the
// migration): a decision record must never be edited or hidden.
// actorName is copied in so the trail stays readable even if a user is later removed.
model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid // null = the system (worker, scheduler)
  actorName     String?
  action        String
  entityType    String
  entityId      String
  batchId       String?  @db.Uuid
  reason        String?
  metadata      Json     @default("{}")
  correlationId String? // the request / job that caused it, to follow one story end to end
  createdAt     DateTime @default(now())

  @@index([batchId, createdAt])
  @@index([entityType, entityId])
}

// One certificate per candidate (unique candidateId). Created by the worker, so
// running the same job twice can never make a second one.
//   number      PSM-<year>-<6 digits> from a database sequence (unique)
//   verifyCode  random, unguessable code printed on the PDF / in its QR; the public
//               verify page looks certificates up by this, not by the guessable number
model Certificate {
  id             String            @id @default(uuid()) @db.Uuid
  candidateId    String            @unique @db.Uuid
  batchId        String            @db.Uuid
  number         String            @unique
  verifyCode     String            @unique
  status         CertificateStatus @default(VALID)
  deliveryStatus DeliveryStatus    @default(PENDING)
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  cancelledById  String?           @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  isActive       Boolean           @default(true)
  createdById    String?           @db.Uuid
  updatedById    String?           @db.Uuid
  meta           Json              @default("{}")

  candidate Candidate         @relation(fields: [candidateId], references: [id])
  batch     Batch             @relation(fields: [batchId], references: [id])
  attempts  DeliveryAttempt[]

  @@index([batchId])
}

// One row per WhatsApp send attempt (success or failure): how a delivery went.
model DeliveryAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  certificateId String   @db.Uuid
  attemptNo     Int
  ok            Boolean
  error         String?
  createdAt     DateTime @default(now())

  certificate Certificate @relation(fields: [certificateId], references: [id])

  @@index([certificateId])
}
