{
  "name": "certiflow-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CertiFlow API and background worker (same codebase, two entrypoints)",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "seed": "tsx src/seed.ts",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bullmq": "6.7.8",
    "csv-parse": "7.0.3",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "pdfkit": "0.21.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "prettier": {
    "printWidth": 120,
    "trailingComma": "all"
  }
}
