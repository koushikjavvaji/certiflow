# Copy to .env if you want to change anything. Docker Compose works with no .env at all:
# every value below has the same default baked into docker-compose.yml.
POSTGRES_USER=certiflow
POSTGRES_PASSWORD=certiflow
POSTGRES_DB=certiflow

# Signs the demo login tokens (min 32 chars). CHANGE THIS outside local development.
JWT_SECRET=dev-only-change-me-please-use-a-long-random-string

# Demo mode adds a "switch person" shortcut with no password. Must be false in production.
# (Email + password sign-in works in both modes.)
DEMO_MODE=true

# Password the seeded accounts (anika@pragati.example, dev@..., meera@..., kabir@..., neha@...,
# farah@..., isha@...) get when first created. This is the demo default; set your own.
SEED_PASSWORD=Pragati#Demo2026
