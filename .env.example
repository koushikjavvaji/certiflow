# Copy to .env (docker compose works without it too: every value has a safe local default).
POSTGRES_USER=certiflow
POSTGRES_PASSWORD=certiflow
POSTGRES_DB=certiflow

# Signs the demo login tokens. CHANGE THIS outside local development.
JWT_SECRET=dev-only-change-me-please-use-a-long-random-string

# Demo mode exposes the "switch user" login. Must be false in production.
DEMO_MODE=true
